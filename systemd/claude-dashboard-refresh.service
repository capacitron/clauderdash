[Unit]
Description=Claude Code Dashboard — fast findings refresh (drift + signal, no LLM)
Documentation=https://github.com/capacitron/clauderdash
After=claude-dashboard.service

[Service]
Type=oneshot
Environment="CLAUDE_DASHBOARD_DATA_DIR=__PROJECT_DIR__/data"
WorkingDirectory=__PROJECT_DIR__
# Two cheap, deterministic passes — no claude CLI, no network beyond localhost:
# 1. curl /api/intelligence: that endpoint IS the scan for source='signal'
#    findings (see panels.py) — a plain GET is enough to refresh them.
# 2. --drift-only: SQL-only pass for source='drift' findings (CLAUDE.md
#    targets table). See generate_recommendations.py for why this is safe
#    to run often without touching llm-sourced findings.
ExecStart=/bin/sh -c 'curl -s -o /dev/null --max-time 5 http://127.0.0.1:7777/api/intelligence; __PROJECT_DIR__/backend/.venv/bin/python __PROJECT_DIR__/scripts/generate_recommendations.py --drift-only'
TimeoutStartSec=30
MemoryMax=256M
CPUQuota=25%
StandardOutput=journal
StandardError=journal
SuccessExitStatus=0 1

[Install]
WantedBy=default.target
