[Unit]
Description=Claude Code Dashboard (local observability)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_DIR__/backend
Environment="PATH=__PROJECT_DIR__/backend/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"
# The fix-queue's `claude mcp remove` auto-run handler (api/fixactions.py)
# shells out to `claude`. The mise shim on PATH resolves it differently
# per-cwd (mise: "No version is set for shim" outside a directory with
# .mise.toml declaring it) and this unit's WorkingDirectory has none, so PATH
# lookup alone is unreliable here. `claude` is a native install, not an npm
# package — %h/.local/bin/claude is the fixed symlink to it, cwd-independent.
Environment="CLAUDE_BIN=%h/.local/bin/claude"
Environment="CLAUDE_DASHBOARD_HOST=127.0.0.1"
Environment="CLAUDE_DASHBOARD_PORT=7777"
ExecStart=__PROJECT_DIR__/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 7777
Restart=on-failure
RestartSec=3
# Reasonable resource bounds for a local daemon
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=default.target
