[Unit]
Description=Claude Code Dashboard — weekly suggestion generator
Documentation=https://github.com/capacitron/claude-dashboard
After=claude-dashboard.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Systemd user services do NOT source .bashrc — raw mise shim needed in PATH
Environment="PATH=/home/capacitron/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin"
# If the `claude` shim won't resolve headless (mise: "No version is set for shim"),
# uncomment and point CLAUDE_BIN at the concrete binary, e.g.:
# Environment="CLAUDE_BIN=%h/.local/share/mise/installs/node/25.0.0/bin/claude"
Environment="CLAUDE_DASHBOARD_DATA_DIR=__PROJECT_DIR__/data"
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/backend/.venv/bin/python __PROJECT_DIR__/scripts/generate_recommendations.py
# Hard timeout kills process if claude API hangs beyond 3 min
TimeoutStartSec=180
MemoryMax=1024M
CPUQuota=50%
# stdout/stderr → journalctl --user -u claude-dashboard-suggestions
StandardOutput=journal
StandardError=journal
# Non-zero exit is logged but does not cascade; panel falls back to EmptyState
SuccessExitStatus=0 1

[Install]
WantedBy=default.target
